# =====================================================================
# ALLIGENT — Environment Configuration Template
# =====================================================================

# LLM Specialist Agents (Local Ollama)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest

# Cloud LLM Failover (Groq API - Optional)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Outbound Voice Escalation (Twilio)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
ENGINEER_PHONE_NUMBER=+1234567890

# Industrial Incident Alerting & PDF Dispatch (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
ALERT_EMAIL_SENDER=Alligent Incident Response <onboarding@resend.dev>
ALERT_EMAIL_RECIPIENT=engineer@yourcompany.com

# Database Services (Docker Internal / Local)
MONGO_URI=mongodb://localhost:27017
REDIS_URI=redis://localhost:6379/0

# Digital Twin Simulation Settings
TICK_INTERVAL_MS=100
SNAPSHOT_INTERVAL_TICKS=30
ANOMALY_SENSITIVITY=0.05
